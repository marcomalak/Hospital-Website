@model Doctor
<form asp-controller="Doctor" asp-action="SaveEdit">
	
	<input type="hidden" asp-for="DoctorId" />
	
	<label>Doctor Name:</label>
	<input type="text" asp-for="Name" />
	<span asp-validation-for="Name" class="text-danger"></span>
	<br /><br />

	<label>Age:</label>
	<input type="number" asp-for="Age" />
	<span asp-validation-for="Age" class="text-danger"></span>
	<br /><br />

	<label>Email:</label>
	<input type="text" asp-for="Email" />
	<span asp-validation-for="Email" class="text-danger"></span>
	<br /><br />

	<label>Phone:</label>
	<input type="number" asp-for="PhoneNumber" />
	<span asp-validation-for="PhoneNumber" class="text-danger"></span>
	<br /><br />

	<label>Salary:</label>
	<input type="number" asp-for="Salary" />
	<span asp-validation-for="Salary" class="text-danger"></span>
	<br /><br />

	<label>Department:</label>
	<select name="DepartmentId">
	@foreach (var dept in ViewBag.Departments)
	{
			if (Model.DepartmentId == dept.DepartmentId)
			{
				<option value="@dept.DepartmentId" selected>@dept.Name</option>
			}
			else
			{
				<option value="@dept.DepartmentId">@dept.Name</option>
			}
	}
	</select>
	<br /><br />
	<input type="submit" value="Save Changes" class="btn btn-primary" />
	<a class="btn btn-warning" href="/Doctor/AllDoctors">Cancel</a>
</form>
