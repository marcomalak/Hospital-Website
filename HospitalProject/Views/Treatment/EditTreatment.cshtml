@model Treatment
<form asp-action="SaveEdit" asp-route-id="@Model.Id" method="post">

	<h2>Edit Treatment</h2>

	<input type="hidden" asp-for="Id" />

	<input type="hidden" asp-for="DoctorId" value="@ViewBag.Doctor.DoctorId" />
	<h4>Doctor: @ViewBag.Doctor.Name</h4>

	<input type="hidden" asp-for="PatientId" value="@ViewBag.Patient.ID" />
	<h4>Patient: @ViewBag.Patient.Name</h4>

	<h4>Disease: @ViewBag.Patient.Disease</h4>
<br />
	<label>Diagnosis: </label>
	<input type="text" asp-for="Diagnosis" value="@Model.Diagnosis" />
	<span asp-validation-for="Diagnosis" class="text-danger"></span>
	<br /><br />

	<button type="submit" class="btn btn-primary">Save</button>
	<a asp-action="AllTreatmentsD" asp-route-doctorId="@Model.DoctorId" class="btn btn-warning">Cancel</a>
</form>