@model Patient
<div class="card" style="width: 40rem;">
    <ul class="list-group list-group-flush">
        <li class="list-group-item">Patient ID : @Model.ID</li>
        <li class="list-group-item">Patient Name : @Model.Name</li>
        <li class="list-group-item">Patient Age : @Model.Age</li>
        <li class="list-group-item">Patient Gender : @Model.Gender</li>
        <li class="list-group-item">Disease : @Model.Disease</li>
        <li class="list-group-item">
            <strong>Doctors:</strong>
            @if (Model.Doctors.Count == 0)
            {
                <ul>
                    <li>You have not assigned any doctors to this patient.</li>
                </ul>
            }
            else
            {
            <ul>
                @foreach (var doctor in Model.Doctors)
                {
                    <li><p>Doctor Name: @doctor.Name => Department: @doctor.Department.Name</p>
                        @if (doctor.Treatments.Any(t => t.PatientId == Model.ID))
                        {
                            <p style="margin-left: 30px;">Diagnosis: @doctor.Treatments.Where(t => t.PatientId == Model.ID).Select(t => t.Diagnosis).FirstOrDefault()</p>
                        }
                    </li>
                }
                </ul>            
            }
        </li>
    </ul>
</div>
<a class="btn btn-outline-info" href="/Patient/AllPatients">Back</a>